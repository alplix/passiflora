+// Largest double T with sqrt(T) <= B.  sqrt is correctly rounded and monotone,
+// so for any double X:  sqrt(X) <= B  <=>  X >= 0 && X <= T  (NaN/negative X
+// give false on both sides; -0.0 gives true on both sides).  This lets the hot
+// loops skip the sqrt while taking exactly the same branches as the original.
+static double sqrtLeLimit(double B) {
+  if(isnan(B) || B < 0.0) return -INFINITY;
+  if(isinf(B)) return INFINITY;
+  double T = B*B;
+  while(sqrt(T) > B) T = nextafter(T, -INFINITY);
+  while(sqrt(nextafter(T, INFINITY)) <= B) T = nextafter(T, INFINITY);
+  return T;
+  }
+
+// Narrow the integer range [*lo,*hi] of m to the values that can still pass
+//     X(m) <= T,   X = a1sq + l1*a1a2 + l2*a2sq   (evaluated in doubles),
+// where a1 = p1*m + c1 and a2 = p2*m + c2.  Along m the exact form
+// Q(m) = A m^2 + B m + C is convex (A > 0), so {Q <= T} is an interval.  We
+// solve Q = T + delta in long double, with delta = 1e-9*(|T| + Smax) far above
+// the rounding error of X (a few ulps of Smax, the largest term sum on the
+// range), and widen the roots by 2.  Every m dropped has Q > T + delta, hence
+// X > T, so the original test would fail there too.  Nothing is narrowed when
+// the range or the coefficients are large enough for int64 overflow to matter.
+static void nfNarrow(pari_long p1, pari_long c1, pari_long p2, pari_long c2,
+                     double l1, double l2, double T, pari_long *lo, pari_long *hi)
+{
+  typedef long double ld;
+  if(*lo > *hi) return;
+  if(T == -INFINITY) { *hi = *lo - 1; return; }  // sqrtLeLimit: nothing passes
+  if(!(T < INFINITY)) return;
+  const ld LIM_M = 1099511627776.0L;   // 2^40
+  const ld LIM_A = 2147483648.0L;      // 2^31: squares and products fit in int64
+  if(fabsl((ld)*lo) > LIM_M || fabsl((ld)*hi) > LIM_M) return;
+  ld a1lo = (ld)p1*(*lo) + c1, a2lo = (ld)p2*(*lo) + c2;
+  ld a1hi = (ld)p1*(*hi) + c1, a2hi = (ld)p2*(*hi) + c2;
+  if(fabsl(a1lo) >= LIM_A || fabsl(a2lo) >= LIM_A || fabsl(a1hi) >= LIM_A || fabsl(a2hi) >= LIM_A) return;
+  ld Slo = a1lo*a1lo + fabsl((ld)l1*a1lo*a2lo) + fabsl((ld)l2)*a2lo*a2lo;
+  ld Shi = a1hi*a1hi + fabsl((ld)l1*a1hi*a2hi) + fabsl((ld)l2)*a2hi*a2hi;
+  ld Smax = (Slo > Shi) ? Slo : Shi;
+  ld A = (ld)p1*p1 + (ld)l1*p1*p2 + (ld)l2*p2*p2;
+  ld B = 2.0L*p1*c1 + (ld)l1*((ld)p1*c2 + (ld)p2*c1) + 2.0L*(ld)l2*p2*c2;
+  ld C = (ld)c1*c1 + (ld)l1*c1*c2 + (ld)l2*c2*c2;
+  if(!(A > 1e-6L)) return;
+  ld Tp = (ld)T + 1e-9L*(fabsl((ld)T) + Smax) + 1e-30L;
+  ld D = B*B - 4.0L*A*(C - Tp);
+  if(D < 0) { *hi = *lo - 1; return; }
+  ld s = sqrtl(D);
+  ld nl = floorl((-B - s)/(2.0L*A)) - 2.0L;
+  ld nh = ceill((-B + s)/(2.0L*A)) + 2.0L;
+  if(nl > (ld)*hi || nh < (ld)*lo || nl > nh) { *hi = *lo - 1; return; }
+  if(nl > (ld)*lo) *lo = (pari_long)nl;
+  if(nh < (ld)*hi) *hi = (pari_long)nh;
+}
