+// Run the pending batch on the GPU, finish the survivors on the CPU exactly like the
+// stock code does, and checkpoint.  (i,N1,..,L2) is the first node NOT in the batch.
+static void nfGpuFlushBatch(pari_long i, pari_long N1, pari_long N2, pari_long k1, pari_long k2,
+                            pari_long L1, pari_long L2, pari_long *StatVec, ofstream& outfile, bool final=false)
+{
+  if(nfGpuEmpty()) return;
+  std::vector<long long> polys;
+  long long inspected = nfGpuRun(polys);
+  if(nfGpuCheck) {
+    if(inspected != nfRefCount) {
+      fprintf(stderr, "NF_GPUCHECK MISMATCH: gpu inspected %lld, cpu %lld\n", inspected, nfRefCount);
+      exit(6);
+      }
+    nfRefCount = 0;
+    }
+  StatVec[0] += inspected;
+
+  int numPrimes = (int)(lg(Sg)-1);
+  int pSet[3];
+  for(int k=0; k<numPrimes; k++)  pSet[k] = (int)itos((GEN)Sg[k+1]);
+  nfPdfSetup(numPrimes, pSet);
+
+  size_t total = polys.size()/11;
+  for(size_t off=0; off<total; off += polyBufferSize) {
+    int m = (int)std::min((size_t)polyBufferSize, total-off);
+    pari_long *buf = (pari_long*)&polys[off*11];
+    nfPdfFilter(buf, m, (signed char*)polGoodFlag);
+    polDiscTest_cpu(buf, m, polGoodFlag, polGoodFlag, numPrimes, pSet);
+    nfFinishPolys(buf, m, StatVec, outfile);
+    }
+
+  if(!final && boinc_time_to_checkpoint())
+    {
+    StatVec[4] = StatVec[4] + (pari_long)floor(myTimer()/1000.0 + .5);
+    pari_long idx[9] = { i, N1, N2, k1, k2, L1, L2, LLONG_MIN, LLONG_MIN };
+    int retval = do_checkpoint(idx, StatVec);
+    if(retval) { fprintf(stderr, "Checkpoint failed!\n"); exit(retval); }
+    boinc_checkpoint_completed();
+    }
+}
