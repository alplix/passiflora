+static void (*nfPdfFilter)(const long long*, int, signed char*) = 0;
+
+// Picks the instruction-set variant of the Fortran filter and initialises it (once).
+static void nfPdfSetup(int numPrimes, int *pSet)
+{
+  if(nfPdfFilter) return;
+  void (*pdfInit)(int, const int*);
+#ifdef NF_PDF_DISPATCH
+  const char *fb = getenv("NF_FORCE_BASE");
+  __builtin_cpu_init();
+  if(!(fb && *fb=='1') && __builtin_cpu_supports("avx2") && __builtin_cpu_supports("fma")) {
+    pdfInit = pdf_init_v3;    nfPdfFilter = pdf_filter_v3;
+    fprintf(stderr, "polDisc pre-filter: AVX2/FMA build.\n");
+    }
+  else {
+    pdfInit = pdf_init_base;  nfPdfFilter = pdf_filter_base;
+    fprintf(stderr, "polDisc pre-filter: baseline build.\n");
+    }
+#else
+  pdfInit = pdf_init;  nfPdfFilter = pdf_filter;
+#endif
+  pdfInit(numPrimes, pSet);
+}
+
+// Irreducibility and field discriminant tests for the polynomials whose flag is set.
+static void nfFinishPolys(pari_long *polBuf, int n, pari_long *StatVec, ofstream& outfile)
+{
+  pari_long *pdCount  = &(StatVec[1]);
+  pari_long *irrCount = &(StatVec[2]);
+  pari_long *fdCount  = &(StatVec[3]);
+  int numPrimes = (int)(lg(Sg)-1);
+  pari_long ltop = avma;
+
+  for(int j=0;j<n;++j)
+    {
+    if(polGoodFlag[j])
+      {
+      (*pdCount)++;
+      GEN f_L = mkpoln( 11, gen_1, stoi(polBuf[j*11+1]), stoi(polBuf[j*11+2]),
+                                   stoi(polBuf[j*11+3]), stoi(polBuf[j*11+4]),
+                                   stoi(polBuf[j*11+5]), stoi(polBuf[j*11+6]),
+                                   stoi(polBuf[j*11+7]), stoi(polBuf[j*11+8]),
+                                   stoi(polBuf[j*11+9]), stoi(polBuf[j*11+10]) );
+      if(isirreducible(f_L))
+        {
+        (*irrCount)++;
+        GEN fldDisc = discf(f_L);
+        for(int k=1;k<=numPrimes;++k)
+          fldDisc = gdiv(fldDisc,gpowgs((GEN)Sg[k],ggval(fldDisc,(GEN)Sg[k])));
+        if(gcmp1(gabs(fldDisc,DEFAULTPREC)))
+          {
+          (*fdCount)++;
+          char *OutStr = GENtostr(f_L);
+          outfile << OutStr << "\n";
+          outfile.flush();
+          free(OutStr);
+          }
+        }
+      avma = ltop;
+      }
+    }
+}
